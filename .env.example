# Get a free API key at https://console.groq.com (no credit card required)
GROQ_API_KEY=your_groq_api_key_here

# Get a free API key at https://tavily.com (1,000 free searches/month, no card)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: override the default model
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: override where SQLite/Chroma data is stored (defaults to ./data)
# DATA_DIR=./data

# Used by the Streamlit frontend to reach the backend.
# For local dev: http://localhost:8000
# For deployed setup: your Render backend URL
BACKEND_URL=http://localhost:8000
